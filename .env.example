# Create an API key in Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional override; leave blank to use the app's ordered fallback models.
GEMINI_MODEL=

# --- Google Cloud (set on Cloud Run by scripts/deploy-cloud-run.sh) ---
# When GOOGLE_VERTEX_PROJECT is set, Gemini is called through Vertex AI (service-account auth, billed to the project).
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=global
# When GCS_BUCKET is set, shared notes go to Firestore + this Cloud Storage bucket instead of ./.data
# GCS_BUCKET=
# GOOGLE_CLOUD_PROJECT=
